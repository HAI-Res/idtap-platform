  "codas": "consonants",
  "vowels": {
    "î": {
      "ipa": "i",
      "height": "close",
      "backness": "front",
      "rounded": false,
      "length": "long",
      "display": {
        "Latn": "î"
      },
      "example": "nîv [niv] half"
    },
    "i": {
      "ipa": "ɪ",
      "height": "near-close",
      "backness": "front",
      "rounded": false,
      "length": "short",
      "display": {
        "Latn": "i"
      },
      "example": "dil [dɪl] heart",
      "variants": [
        {
          "ipa": "ɨ",
          "context": "often in closed syllables ending in m",
          "example": "vedixwim [ˈvædɪxwɨm] I drink"
        }
      ]
    },
    "ê": {
      "ipa": "e",
      "height": "close-mid",
      "backness": "front",
      "rounded": false,
      "length": "long",
      "display": {
        "Latn": "ê"
      },
      "example": "hêz [hez] power"
    },
    "e": {
      "ipa": "æ",
      "height": "near-open",
      "backness": "front",
      "rounded": false,
      "length": "short",
      "display": {
        "Latn": "e"
      },
      "example": "berhem [bæɾˈhæm] product",
      "variants": [
        {
          "ipa": "ə",
          "context": "in the sequence ew",
          "example": "ew [əw] that"
        },
        {
          "ipa": "ɛ",
          "context": "followed by y in another syllable",
          "example": "odeya [oˈdɛjɑ] room"
        },
        {
          "ipa": "ɛ",
          "context": "after the stress, particularly word-finally",
          "example": "miróvek [mɪˈrovɛk] a man"
        }
      ],
      "note": "Thackston takes [æ] as the reference pronunciation; many speakers are closer to [ɛ]."
    },
    "û": {
      "ipa": "u",
      "height": "close",
      "backness": "back",
      "rounded": true,
      "length": "long",
      "display": {
        "Latn": "û"
      },
      "example": "bûn [bun] to be"
    },
    "u": {
      "ipa": "ʊ",
      "height": "near-close",
      "backness": "back",
      "rounded": true,
      "length": "short",
      "display": {
        "Latn": "u"
      },
      "example": "du [dʊ] two",
      "variants": [
        {
          "ipa": "ɯɛ",
          "context": "after g and k for some speakers, particularly in closed syllables",
          "example": "gur [gɯɛɾ] or [gʊɾ] wolf",
